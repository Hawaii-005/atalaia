{
  "expo": {
    "name": "Atalaia",
    "slug": "atalaia",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "version": "2.4.3",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.brunocrazy15.atalaia",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app needs to access your local network to connect to your 3D printers.",
        "NSBonjourServices": [
          "_bonjour._tcp",
          "_lnp._tcp."
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#100E20"
      },
      "package": "io.github.brunocrazy15.atalaia",
      "versionCode": 143
    },
    "developmentClient": {
      "silenceDeploymentWarnings": true
    }
  }
}
