<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#f8f9fa">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atalaia Slicer • Spike de Viabilidade"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDeviceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A carregar dados do aparelho..."
        android:textSize="12sp"
        android:textColor="#495057"
        android:background="#ffffff"
        android:padding="10dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pronto para iniciar benchmark."
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum teste executado ainda."
        android:textSize="13sp"
        android:textColor="#343a40"
        android:background="#ffffff"
        android:padding="12dp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="EXECUTAR BENCHMARK LOCAL"
        android:backgroundTint="#212529"
        android:textColor="#ffffff"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="PARTILHAR RELATÓRIO JSON"
        android:backgroundTint="#495057"
        android:textColor="#ffffff"
        android:enabled="false" />

</LinearLayout>
